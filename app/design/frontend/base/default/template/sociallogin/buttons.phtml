<?php
/**
 * MageAustralia Social Login — provider buttons for login/register pages.
 *
 * @var MageAustralia_SocialLogin_Block_Buttons $this
 */
$providers = $this->getProviders();
if (empty($providers)) return;

$google   = null;
$apple    = null;
$facebook = null;
foreach ($providers as $p) {
    if ($p['code'] === 'google')   $google   = $p;
    if ($p['code'] === 'apple')    $apple    = $p;
    if ($p['code'] === 'facebook') $facebook = $p;
}
?>
<div class="social-login-buttons"
     id="social-login-buttons"
     data-login-url="<?= $this->escapeUrl($this->getLoginUrl()) ?>"
     <?php if ($google): ?>data-google-client-id="<?= $this->escapeHtml($google['clientId']) ?>"<?php endif ?>
     <?php if ($apple): ?>data-apple-service-id="<?= $this->escapeHtml($apple['serviceId']) ?>"<?php endif ?>
     <?php if ($facebook): ?>data-facebook-app-id="<?= $this->escapeHtml($facebook['appId']) ?>"<?php endif ?>
     <?php if ($this->isOtpEnabled()): ?>data-otp-link-request-url="<?= $this->escapeUrl($this->getOtpLinkRequestUrl()) ?>" data-otp-link-verify-url="<?= $this->escapeUrl($this->getOtpLinkVerifyUrl()) ?>"<?php endif ?>
>
    <?php if (!$this->getHideDivider()): ?>
    <div class="social-login-divider">
        <span><?= $this->__('or') ?></span>
    </div>
    <?php endif ?>

    <div class="social-login-actions">
        <?php if ($google): ?>
        <!-- Native Google Identity Services button rendered here by sociallogin.js;
             personalises to "Sign in as <name>" when the visitor has a Google session. -->
        <div id="social-login-google-button" class="social-login-google-button"></div>
        <?php endif ?>

        <?php if ($apple): ?>
        <button type="button" class="social-login-btn social-login-apple" onclick="MahoSocialLogin.login('apple')">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            <span><?= $this->__('Continue with Apple') ?></span>
        </button>
        <?php endif ?>

        <?php if ($facebook): ?>
        <button type="button" class="social-login-btn social-login-facebook" onclick="MahoSocialLogin.login('facebook')">
            <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            <span><?= $this->__('Continue with Facebook') ?></span>
        </button>
        <?php endif ?>
    </div>

    <!-- Account linking prompt (shown when existing account found) -->
    <div id="social-login-link-prompt" style="display:none">
        <div class="social-login-message social-login-info"></div>
        <div class="social-login-link-form">
            <ul class="form-list">
                <li>
                    <label for="social-link-password" class="required"><?= $this->__('Password') ?></label>
                    <div class="input-box">
                        <input type="password" id="social-link-password" class="input-text" autocomplete="current-password" />
                    </div>
                </li>
            </ul>
            <div class="buttons-set">
                <button type="button" class="button" onclick="MahoSocialLogin.linkAccount(event)"><span><?= $this->__('Link Account') ?></span></button>
                <a href="<?= $this->getUrl('customer/account/forgotpassword') ?>" class="f-left"><?= $this->__('Forgot Your Password?') ?></a>
            </div>
        </div>

        <?php if ($this->isOtpEnabled()): ?>
        <!-- Alternative: link via an emailed verification code instead of the password. -->
        <div class="social-login-otp-link">
            <p class="social-login-otp-link-start">
                <button type="button" class="social-login-link-otp" data-otp-link-start><?= $this->escapeHtml($this->__('Email me a code instead')) ?></button>
            </p>
            <div class="social-login-otp-link-code" style="display:none">
                <ul class="form-list">
                    <li>
                        <label for="social-link-otp-code" class="required"><?= $this->escapeHtml($this->__('Verification code')) ?></label>
                        <div class="input-box">
                            <input type="text" id="social-link-otp-code" class="input-text" inputmode="numeric" autocomplete="one-time-code" />
                        </div>
                    </li>
                </ul>
                <div class="buttons-set">
                    <button type="button" class="button" data-otp-link-verify><span><?= $this->escapeHtml($this->__('Verify code')) ?></span></button>
                </div>
            </div>
        </div>
        <?php endif ?>
    </div>

    <div id="social-login-error" class="social-login-message social-login-error" style="display:none"></div>
</div>
