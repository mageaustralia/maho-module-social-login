<?php
/**
 * MageAustralia Social Login - reusable passwordless sign-in block.
 *
 * Renders core Magic Link (email link) and our SMS one-time-code login in one
 * include, safe to drop into multiple login entry points on the same page.
 *
 * @var MageAustralia_SocialLogin_Block_Passwordless $this
 */
if (!$this->shouldRender()) {
    return;
}

$magic = $this->isMagicLinkEnabled();
$otp   = $this->isOtpEnabled();
$btnClass = $this->escapeHtml((string) $this->getBtnClass());
?>
<style>
.mha-pwl { margin-top: 1.25rem; }
.mha-pwl-divider { display: flex; align-items: center; gap: .75rem; margin: 1rem 0; color: #888; font-size: .85rem; }
.mha-pwl-divider::before, .mha-pwl-divider::after { content: ""; flex: 1; height: 1px; background: currentColor; opacity: .35; }
.mha-pwl-field { margin: .5rem 0; }
.mha-pwl-field input { width: 100%; box-sizing: border-box; padding: 1.2rem 1rem; border: 1px solid var(--cart-summary--border-color, #ccc); border-radius: 0; background: var(--white, #fff); color: var(--gray, #5a5a5a); font-size: 12px; }
.mha-pwl-field input:focus { outline: none; border-color: var(--gray, #5a5a5a); }
.mha-pwl-btn {
    display: block; width: 100%; margin-top: .5rem; margin-bottom: 1rem;
    padding: 1.2rem 1rem;
    border: 1px solid var(--cart-summary--border-color, #ccc); border-radius: 0;
    background: var(--white, #fff); color: var(--gray, #5a5a5a);
    font-size: 12px; text-transform: uppercase;
    text-shadow: none; box-shadow: none;
    cursor: pointer;
    transition: background .3s ease-in-out;
}
.mha-pwl-btn:hover, .mha-pwl-btn:focus { background: var(--light-gray, #f3f3f3); color: var(--white, #fff); outline: none; }
.mha-pwl-btn:disabled { opacity: .55; cursor: default; }
.mha-pwl-btn--primary { background: var(--green-alt, #8dd146); color: var(--white, #fff); }
.mha-pwl-btn--primary:hover, .mha-pwl-btn--primary:focus { background: var(--green, #79d31e); color: var(--white, #fff); }
.mha-pwl-row { margin: .75rem 0; }
.mha-pwl-step { margin-top: .5rem; }
.mha-pwl-msg { margin-top: .5rem; font-size: .85rem; min-height: 1em; color: #555; }
</style>
<div class="mha-pwl"
     data-otp-request-url="<?= $this->escapeUrl($this->getOtpRequestUrl()) ?>"
     data-otp-verify-url="<?= $this->escapeUrl($this->getOtpVerifyUrl()) ?>"
     data-form-key="<?= $this->escapeHtml($this->getFormKey()) ?>"
     data-btn-class="<?= $btnClass ?>">

    <div class="mha-pwl-divider"><?= $this->escapeHtml($this->__('or sign in without a password')) ?></div>

    <?php if ($magic): ?>
    <form class="mha-pwl-magic mha-pwl-row" method="post" action="<?= $this->escapeUrl($this->getMagicLinkRequestUrl()) ?>">
        <input type="hidden" name="form_key" value="<?= $this->escapeHtml($this->getFormKey()) ?>">
        <div class="mha-pwl-field">
            <input type="email" name="email" class="mha-pwl-email" autocomplete="email"
                   placeholder="<?= $this->escapeHtml($this->__('Email address')) ?>" required>
        </div>
        <button type="submit" class="mha-pwl-btn <?= $btnClass ?>">
            <?= $this->escapeHtml($this->__('Email me a login link')) ?>
        </button>
    </form>
    <?php endif ?>

    <?php if ($otp): ?>
    <div class="mha-pwl-sms mha-pwl-row">
        <?php if (!$magic): ?>
        <div class="mha-pwl-field">
            <input type="email" class="mha-pwl-email" autocomplete="email"
                   placeholder="<?= $this->escapeHtml($this->__('Email address')) ?>">
        </div>
        <?php endif ?>
        <button type="button" class="mha-pwl-sms-send mha-pwl-btn <?= $btnClass ?>">
            <?= $this->escapeHtml($this->__('Text me a code')) ?>
        </button>

        <div class="mha-pwl-code-step mha-pwl-step" style="display:none">
            <div class="mha-pwl-field">
                <input type="text" class="mha-pwl-code" inputmode="numeric" maxlength="10"
                       autocomplete="one-time-code"
                       placeholder="<?= $this->escapeHtml($this->__('Enter the code')) ?>">
            </div>
            <button type="button" class="mha-pwl-sms-verify mha-pwl-btn mha-pwl-btn--primary <?= $btnClass ?>">
                <?= $this->escapeHtml($this->__('Verify and sign in')) ?>
            </button>
        </div>
    </div>
    <?php endif ?>

    <div class="mha-pwl-msg" role="status" aria-live="polite"></div>
</div>

<script>
(function () {
    function initRoot(root) {
        if (root.dataset.mhaPwlReady) { return; }
        root.dataset.mhaPwlReady = '1';

        var formKey = root.getAttribute('data-form-key') || '';
        var requestUrl = root.getAttribute('data-otp-request-url') || '';
        var verifyUrl = root.getAttribute('data-otp-verify-url') || '';

        var magicForm = root.querySelector('.mha-pwl-magic');
        var sendBtn = root.querySelector('.mha-pwl-sms-send');
        var verifyBtn = root.querySelector('.mha-pwl-sms-verify');
        var codeStep = root.querySelector('.mha-pwl-code-step');
        var codeInput = root.querySelector('.mha-pwl-code');
        var msg = root.querySelector('.mha-pwl-msg');

        function emailValue() {
            var el = root.querySelector('.mha-pwl-email');
            return el ? el.value.trim() : '';
        }
        function setMsg(text) {
            if (msg) { msg.textContent = text || ''; }
        }

        function currentReturnPath() {
            // Skip login/create/forgot pages — they're not useful return targets
            var p = window.location.pathname || '/';
            if (/^\/customer\/account\/(login|create|forgotpassword|magiclink)/.test(p)) return '';
            return p + (window.location.search || '') + (window.location.hash || '');
        }

        function post(url, params) {
            var body = new URLSearchParams(params);
            return fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                credentials: 'same-origin',
                body: body.toString()
            }).then(function (r) { return r.json(); });
        }

        if (magicForm) {
            // Core /customer/account/magiclinkrequestpost always redirects back to
            // magiclinkrequest page. We submit via fetch so the buyer stays put,
            // then show the generic "we have sent you an email" status (matches
            // cores no-reveal policy on whether the email exists).
            magicForm.addEventListener('submit', function (e) {
                e.preventDefault();
                var magicBtn = magicForm.querySelector('button[type="submit"]');
                var email = emailValue();
                if (!email) { setMsg('Please enter your email address.'); return; }
                if (magicBtn) magicBtn.disabled = true;
                setMsg('');
                var fd = new FormData(magicForm);
                fetch(magicForm.action, {
                    method: 'POST',
                    body: fd,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function () {
                    setMsg('If your email matches an account, weve sent a login link. Check your inbox.');
                })
                .catch(function () { setMsg('Something went wrong. Please try again.'); })
                .finally(function () {
                    if (magicBtn) setTimeout(function () { magicBtn.disabled = false; }, 15000);
                });
            });
        }

        if (sendBtn) {
            sendBtn.addEventListener('click', function () {
                if (sendBtn.disabled) { return; }
                var email = emailValue();
                if (!email) { setMsg('Please enter your email address.'); return; }
                sendBtn.disabled = true;
                setMsg('');
                post(requestUrl, { form_key: formKey, email: email, purpose: 'login' })
                    .then(function (data) {
                        if (codeStep) { codeStep.style.display = ''; }
                        setMsg((data && data.message) ? data.message : '');
                        if (codeInput) { codeInput.focus(); }
                    })
                    .catch(function () { setMsg('Something went wrong. Please try again.'); })
                    .finally(function () {
                        setTimeout(function () { sendBtn.disabled = false; }, 15000);
                    });
            });
        }

        if (verifyBtn) {
            verifyBtn.addEventListener('click', function () {
                if (verifyBtn.disabled) { return; }
                var email = emailValue();
                var code = codeInput ? codeInput.value.trim() : '';
                if (!email || !code) { setMsg('Please enter the code we sent you.'); return; }
                verifyBtn.disabled = true;
                setMsg('');
                post(verifyUrl, { form_key: formKey, email: email, code: code, redirect: currentReturnPath() })
                    .then(function (data) {
                        if (data && data.ok && data.redirect) {
                            // Clear FPC's optimistic cart/state cache (if FPC
                            // is in use) before navigating. The next page
                            // would otherwise render its cart-count badge
                            // from the cached GUEST cart_qty in localStorage,
                            // which now disagrees with the logged-in
                            // customer's cart. The FPC fetch on the new
                            // page re-populates fresh state.
                            try {
                                window.localStorage.removeItem('_fpc_state_v1');
                            } catch (e) { /* private mode etc. */ }
                            window.location.href = data.redirect;
                            return;
                        }
                        setMsg((data && data.message) ? data.message : 'Invalid or expired code.');
                        verifyBtn.disabled = false;
                    })
                    .catch(function () {
                        setMsg('Something went wrong. Please try again.');
                        verifyBtn.disabled = false;
                    });
            });
        }
    }

    function initAll() {
        var roots = document.querySelectorAll('.mha-pwl');
        for (var i = 0; i < roots.length; i++) { initRoot(roots[i]); }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
    } else {
        initAll();
    }
})();
</script>
